# Fill these values on each Agent/Harness host.
# Use the fixed private IPv4 address of the OpenContracts/Caddy server.
OPENCONTRACTS_BASE_URL=
OPENCONTRACTS_MCP_URL=

# Fill with the actual public OpenContracts corpus slugs.
OPENCONTRACTS_HISTORY_CORPUS=
OPENCONTRACTS_TEMPLATE_CORPUS=
OPENCONTRACTS_KNOWLEDGE_CORPUS=

# Path to the Caddy internal root certificate installed on this Agent/Harness host.
OPENCONTRACTS_CA_BUNDLE=
NODE_EXTRA_CA_CERTS=

# One-time WorkerKey minted for the history corpus. Keep outside source control.
OPENCONTRACTS_UPLOAD_WORKER_KEY=

OPENCONTRACTS_ALLOW_INSECURE_HTTP=0
OPENCONTRACTS_UPLOAD_TIMEOUT_SECONDS=60
