# OpenContracts connection inside the trusted network
OPENCONTRACTS_BASE_URL=https://contracts.internal.example
OPENCONTRACTS_MCP_URL=https://contracts.internal.example/mcp/

# Public-in-deployment corpus slugs used by the Skill Pack
OPENCONTRACTS_HISTORY_CORPUS=contracts-history
OPENCONTRACTS_TEMPLATE_CORPUS=contract-templates
OPENCONTRACTS_KNOWLEDGE_CORPUS=approved-knowledge

# REST write credential. Keep empty in source control.
# Bound server-side to the formal history corpus.
OPENCONTRACTS_UPLOAD_WORKER_KEY=

# HTTPS is expected even on the LAN. Use 1 only for deliberate local development.
OPENCONTRACTS_ALLOW_INSECURE_HTTP=0

# Client-side timeout for the upload helper. Timeout is treated as commit-unknown.
OPENCONTRACTS_UPLOAD_TIMEOUT_SECONDS=60
