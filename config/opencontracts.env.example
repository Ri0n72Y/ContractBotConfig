# OpenContracts connection
OPENCONTRACTS_BASE_URL=https://contracts.example.com
OPENCONTRACTS_MCP_URL=https://contracts.example.com/mcp/me/

# Private corpus slugs visible to the authenticated MCP identity
OPENCONTRACTS_HISTORY_CORPUS=contracts-history
OPENCONTRACTS_TEMPLATE_CORPUS=contract-templates
OPENCONTRACTS_KNOWLEDGE_CORPUS=approved-knowledge
OPENCONTRACTS_LEARNING_CORPUS=learning-inbox

# REST write credentials. Keep empty in source control.
# Use a CorpusAccessToken/WorkerKey bound to the formal contract-history corpus.
OPENCONTRACTS_UPLOAD_WORKER_KEY=

# Use a different WorkerKey bound only to learning-inbox.
OPENCONTRACTS_LEARNING_WORKER_KEY=

# Optional fallback for Harnesses that cannot perform OpenContracts OAuth.
# Prefer OAuth on /mcp/me/ when supported. Never put this value in SKILL.md.
OPENCONTRACTS_MCP_BEARER_TOKEN=

# Production must use HTTPS. Set to 1 only for explicit local development.
OPENCONTRACTS_ALLOW_INSECURE_HTTP=0

# Client-side timeout for the upload helper. Timeout is treated as commit-unknown.
OPENCONTRACTS_UPLOAD_TIMEOUT_SECONDS=60
