# Required OpenContracts runtime values. Fill these on each Agent/Harness host.
OPENCONTRACTS_BASE_URL=
OPENCONTRACTS_MCP_URL=

# Public corpus slugs used by the Skill Pack. Fill with the actual OpenContracts slugs.
OPENCONTRACTS_HISTORY_CORPUS=
OPENCONTRACTS_TEMPLATE_CORPUS=
OPENCONTRACTS_KNOWLEDGE_CORPUS=

# Caddy internal-CA certificate path on the Agent/Harness host.
# The deployment helper exports this certificate from the Caddy container.
OPENCONTRACTS_CA_BUNDLE=

# WorkBuddy/CodeBuddy MCP client CA compatibility. Point to the same root certificate.
NODE_EXTRA_CA_CERTS=

# REST write credential. Fill with the one-time WorkerKey minted for the history corpus.
OPENCONTRACTS_UPLOAD_WORKER_KEY=

# HTTPS is required for the MVP network path.
OPENCONTRACTS_ALLOW_INSECURE_HTTP=0

# Client-side timeout for the upload helper. Timeout is treated as commit-unknown.
OPENCONTRACTS_UPLOAD_TIMEOUT_SECONDS=60
