# Copy to deploy/opencontracts/.env on the OpenContracts host.
# Deployment-specific values only. Do not commit the resulting .env.

# Existing upstream OpenContracts local compose file.
OPENCONTRACTS_LOCAL_YML=C:/path/to/OpenContracts/local.yml

# Fixed private IPv4 served by Caddy.
OPENCONTRACTS_LAN_IP=10.10.20.15

# Caddy settings.
CADDY_IMAGE=caddy:2-alpine
CADDY_CONTAINER_NAME=contractbot-opencontracts-caddy
CADDY_CA_OUTPUT=runtime/opencontracts-caddy-root.crt

# ContractBot OpenContracts corpuses.
HISTORY_CORPUS=contracts-history
TEMPLATE_CORPUS=contract-templates

# Formal-ingestion WorkerKey. Store the minted plaintext key only in the
# untracked deploy/opencontracts/.env on the OpenContracts host.
OPENCONTRACTS_UPLOAD_WORKER_KEY=

# WorkerKey minting policy used only when mint-worker-key is run.
WORKER_NAME=contractbot-formal-ingest
WORKER_RATE_LIMIT=30
WORKER_EXPIRES_DAYS=365
