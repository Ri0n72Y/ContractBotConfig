# Copy to deploy/opencontracts/.env on the OpenContracts host.
# This file contains deployment values only. Do not commit the resulting .env.

# Existing upstream OpenContracts checkout. Its local.yml remains unchanged.
OPENCONTRACTS_DIR=/opt/OpenContracts

# Fixed private IPv4 served by Caddy.
OPENCONTRACTS_LAN_IP=10.10.20.15

# Docker network used by the running OpenContracts django service.
# Discover it with: ./opencontracts-admin.sh network
OPENCONTRACTS_DOCKER_NETWORK=opencontracts_default

# Service address reachable from Caddy after joining the network above.
OPENCONTRACTS_UPSTREAM=django:8000

# Caddy image/container settings.
CADDY_IMAGE=caddy:2-alpine
CADDY_CONTAINER_NAME=contractbot-opencontracts-caddy

# The only two OpenContracts retrieval corpuses used by the MVP.
HISTORY_CORPUS=contracts-history
TEMPLATE_CORPUS=contract-templates

# Formal-ingestion WorkerKey policy. The generated token is printed once and
# must be copied into the Agent/Harness secret environment; never put it here.
WORKER_NAME=contractbot-formal-ingest
WORKER_RATE_LIMIT=30
WORKER_EXPIRES_DAYS=365
