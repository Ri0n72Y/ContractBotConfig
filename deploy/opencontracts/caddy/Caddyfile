{
    auto_https disable_redirects
    admin off
}

https://{$OPENCONTRACTS_LAN_IP} {
    tls internal

    handle /mcp/* {
        reverse_proxy django:8000 {
            header_up Host localhost:8000
        }
    }

    handle /api/imports/documents/* {
        reverse_proxy django:8000 {
            header_up Host localhost:8000
        }
    }

    handle {
        respond 404
    }
}
