{
    admin off
}

http://{$OPENCONTRACTS_LAN_IP} {
    @mcp path /mcp /mcp/*
    handle @mcp {
        reverse_proxy opencontracts-api:8000 {
            header_up Host localhost:8000
            flush_interval -1
        }
    }

    @imports path /api/imports/documents /api/imports/documents/*
    handle @imports {
        reverse_proxy opencontracts-api:8000 {
            header_up Host localhost:8000
            header_up Authorization "WorkerKey {$OPENCONTRACTS_UPLOAD_WORKER_KEY}"
        }
    }

    handle {
        respond 404
    }
}
