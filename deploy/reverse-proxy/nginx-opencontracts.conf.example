server {
    listen 443 ssl;
    server_name contracts.internal.example;

    # Replace with certificates issued by your public/internal CA.
    ssl_certificate     /etc/nginx/certs/opencontracts.crt;
    ssl_certificate_key /etc/nginx/certs/opencontracts.key;

    client_max_body_size 100m;

    location / {
        proxy_pass http://opencontracts-upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
    }
}
