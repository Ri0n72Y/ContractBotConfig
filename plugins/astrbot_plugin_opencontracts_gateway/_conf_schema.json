{
  "base_url": {
    "description": "OpenContracts 服务根地址",
    "type": "string",
    "default": "http://opencontracts-api:8000"
  },
  "auth_token": {
    "description": "OpenContracts CorpusAccessToken 的 WorkerKey；写入目标由该 WorkerKey 绑定",
    "type": "string",
    "default": "",
    "obvious_hint": true
  },
  "import_path": {
    "description": "OpenContracts 官方单文档导入端点",
    "type": "string",
    "default": "/api/imports/documents/"
  },
  "default_make_public": {
    "description": "导入文档是否公开",
    "type": "bool",
    "default": false
  },
  "allowed_roots": {
    "description": "允许上传的暂存根目录",
    "type": "list",
    "default": [
      "/AstrBot/data/plugins_data/astrbot_plugin_contract_file_router/inbox"
    ]
  },
  "data_dir": {
    "description": "追加式上传审计 receipt 目录",
    "type": "string",
    "default": "data/plugins_data/astrbot_plugin_opencontracts_gateway"
  },
  "router_state_path": {
    "description": "合同路由状态文件，用于验证重新上传确认",
    "type": "string",
    "default": "data/plugins_data/astrbot_plugin_contract_file_router/pending_contract_files.json"
  },
  "require_expected_sha256": {
    "description": "强制校验任务 SHA-256",
    "type": "bool",
    "default": true
  },
  "max_file_bytes": {
    "description": "单文件最大字节数",
    "type": "int",
    "default": 104857600
  },
  "timeout_seconds": {
    "description": "WorkerKey 导入请求超时秒数",
    "type": "int",
    "default": 120
  },
  "confirmation_ttl_seconds": {
    "description": "重新上传确认有效期",
    "type": "int",
    "default": 3600
  },
  "verify_tls": {
    "description": "HTTPS 证书验证",
    "type": "bool",
    "default": true
  }
}
