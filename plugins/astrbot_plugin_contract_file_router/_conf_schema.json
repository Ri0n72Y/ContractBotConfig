{
  "allowed_platforms": {
    "description": "启用平台",
    "type": "list",
    "default": ["wecom"]
  },
  "data_dir": {
    "description": "插件数据目录",
    "type": "string",
    "default": "data/plugins_data/astrbot_plugin_contract_file_router"
  },
  "send_upload_ack": {
    "description": "开始任务时立即确认",
    "type": "bool",
    "default": true
  },
  "upload_ack_text": {
    "description": "首次上传开始确认语",
    "type": "string",
    "default": "好的，正在进行任务。"
  },
  "reupload_ack_text": {
    "description": "客户确认重复上传后的确认语",
    "type": "string",
    "default": "好的，正在重新处理。"
  },
  "dedup_ttl_seconds": {
    "description": "平台重复回调抑制时间",
    "type": "int",
    "default": 15
  },
  "pending_ttl_seconds": {
    "description": "等待用户选择或确认的会话有效期",
    "type": "int",
    "default": 1800
  },
  "staging_ttl_seconds": {
    "description": "未被主动清理的暂存文件最长保留时间",
    "type": "int",
    "default": 172800
  },
  "max_file_bytes": {
    "description": "最大文件字节数",
    "type": "int",
    "default": 104857600
  },
  "active_task_timeout_seconds": {
    "description": "运行标记超时；超时后下一条消息恢复可操作状态",
    "type": "int",
    "default": 900
  },
  "cancelled_tasks_path": {
    "description": "已结束任务登记文件，供最终结果保护插件抑制迟到结果",
    "type": "string",
    "default": "data/plugins_data/astrbot_plugin_contract_file_router/cancelled_contract_tasks.json"
  },
  "cancelled_task_ttl_seconds": {
    "description": "已结束任务登记保留时间",
    "type": "int",
    "default": 172800
  }
}