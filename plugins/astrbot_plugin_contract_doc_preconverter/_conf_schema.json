{
  "allowed_platforms": {
    "description": "启用平台",
    "type": "list",
    "default": ["wecom"]
  },
  "enabled": {
    "description": "启用旧版 Word .doc 转 PDF",
    "type": "bool",
    "default": true
  },
  "converter_url": {
    "description": "Gotenberg LibreOffice 转换完整地址",
    "type": "string",
    "default": "http://gotenberg:3000/forms/libreoffice/convert"
  },
  "request_timeout_seconds": {
    "description": "单次转换超时秒数",
    "type": "int",
    "default": 90
  },
  "max_file_bytes": {
    "description": "原文件及转换后 PDF 最大字节数",
    "type": "int",
    "default": 104857600
  },
  "data_dir": {
    "description": "转换文件与审计记录目录",
    "type": "string",
    "default": "data/plugins_data/astrbot_plugin_contract_doc_preconverter"
  },
  "staging_ttl_seconds": {
    "description": "转换后临时 PDF 最长保留时间",
    "type": "int",
    "default": 172800
  }
}
